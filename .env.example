# =============================================================================
# Property Price Intelligence Agent — environment configuration
# Copy to `.env` and fill in. NOTHING here is required to run the demo stack.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Local (homebrew postgres):  postgresql+psycopg://$USER@localhost:5432/property_intel
# Docker compose:             postgresql+psycopg://postgres:postgres@db:5432/property_intel
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/property_intel

# --- LLM providers -------------------------------------------------------------
# If BOTH are absent the app runs in `offline_deterministic` mode: the reranker and
# assessor fall back to auditable rule-based components. Results are clearly
# labelled and confidence is capped. The app never fabricates model output.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which chat model backs the reranker + assessor. auto | openai | anthropic | offline
LLM_BACKEND=auto
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# --- Embeddings ----------------------------------------------------------------
# auto | openai | offline
# `offline` uses a deterministic concept-lexicon encoder (NO training, NO model
# hosting). Semantic recall is materially weaker than a real embedding API and the
# API reports this via `embedding_mode` on every analysis.
EMBEDDING_BACKEND=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Property data providers ---------------------------------------------------
# demo | proptrack | domain
PROPERTY_PROVIDER=demo

PROPTRACK_CLIENT_ID=
PROPTRACK_CLIENT_SECRET=
PROPTRACK_API_KEY=
PROPTRACK_BASE_URL=https://data.proptrack.com

DOMAIN_API_KEY=
DOMAIN_BASE_URL=https://api.domain.com.au

# --- Optional location enrichment ---------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Observability (optional; absence must never break the app) ----------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=property-price-intelligence
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Retrieval tuning ----------------------------------------------------------
DEFAULT_RADIUS_KM=3.0
MAX_RADIUS_KM=8.0
DEFAULT_LOOKBACK_MONTHS=12
MAX_LOOKBACK_MONTHS=24
HYBRID_CANDIDATE_LIMIT=24
MIN_STRONG_COMPARABLES=5
TARGET_COMPARABLES=8

# --- Frontend ------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
